JWT_SECRET=aVerySecretKeyThatIsAtLeast256BitsLongAndShouldBeStoredSecurely
SPRING_DATASOURCE_PASSWORD=1234
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Pasarela Stripe (modo prueba: https://dashboard.stripe.com/test/apikeys)
PAYMENT_GATEWAY_PROVIDER=stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Stripe redirige aquí tras pagar; el backend confirma y envía al frontend (STRIPE_RETURN_URL)
STRIPE_SUCCESS_URL=http://localhost:8084/api/v1/payments/callback/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_RETURN_URL=http://localhost:5500/pago.html?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:8084/api/v1/payments/callback/cancel
STRIPE_CANCEL_RETURN_URL=http://localhost:5500/pago.html?cancelled=true